{
  "name": "edgeweft",
  "version": "0.1.0-beta.0",
  "description": "A layered 3D dependency graph for React",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstafford5380/edgeweft.git"
  },
  "bugs": "https://github.com/jstafford5380/edgeweft/issues",
  "homepage": "https://github.com/jstafford5380/edgeweft#readme",
  "type": "module",
  "files": [
    "dist",
    "assets/dependency-graph-3d.jpg"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/edgeweft.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "release": "bash ./scripts/release.sh"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.160"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
